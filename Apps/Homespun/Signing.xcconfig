// Signing for device builds. Put your own team in Local.xcconfig next to this file
// (git-ignored), for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//
// Debug builds use a separate bundle ID, so a free Personal Team never registers the
// App Store ID. (A Personal Team can't use the App Group the widgets need: see README, "Running it on
// your iPhone".) If Xcode says the ID is not available, add a suffix in Local.xcconfig:
//
//   HOMESPUN_BUNDLE_ID = photos.homespun.app.dev.yourname

CODE_SIGN_STYLE = Automatic
HOMESPUN_BUNDLE_ID = photos.homespun.app
HOMESPUN_BUNDLE_ID[config=Debug] = photos.homespun.app.dev

#include? "Local.xcconfig"
#include "ReleaseFeatures.xcconfig"
