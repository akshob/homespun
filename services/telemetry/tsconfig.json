{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/vitest-plugin/types"],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["worker-configuration.d.ts", "src/**/*.ts", "test/**/*.ts"]
}
