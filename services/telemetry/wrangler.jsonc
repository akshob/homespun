// Homespun opt-in telemetry: analytics events, MetricKit payloads and bug reports.
// See README.md for the API contract and deploy steps.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "homespun-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-13",
	// Keep our own console logs, but not per-request invocation logs (they include client metadata).
	"observability": { "logs": { "enabled": true, "invocation_logs": false } },

	"vars": {
		// Public noise filter sent by the app as `X-Homespun-Key`. Not a secret.
		"APP_KEY": "homespun-app-v1",
		// Hard usage caps (digits only), 80% of the free tiers by default. See README "Budget".
		"R2_MAX_BYTES": "8000000000",
		"R2_MAX_PUTS_MONTH": "800000",
		"R2_MAX_PUTS_DAY": "25000",
		"R2_MAX_BYTES_DAY": "250000000",
		"EVENTS_MAX_DAY": "20000",
		"REPORT_EMAILS_MAX_DAY": "50",
		"D1_MAX_WRITES_DAY": "80000"
	},

	// Bug reports are emailed here. Set with `wrangler secret put REPORT_TO`; never commit it.
	"secrets": { "required": ["REPORT_TO"] },

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "homespun-telemetry",
			// From `wrangler d1 create homespun-telemetry`.
			"database_id": "de9ae496-7913-4875-9040-8baf16fac540",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "homespun-telemetry" }],

	// Per-IP limits. The binding only supports 10 s or 60 s periods.
	"ratelimits": [
		{ "name": "LIMITER", "namespace_id": "4701", "simple": { "limit": 60, "period": 60 } },
		{ "name": "REPORT_LIMITER", "namespace_id": "4702", "simple": { "limit": 2, "period": 60 } }
	],

	// Email Routing: may send only to verified destination addresses (REPORT_TO).
	"send_email": [{ "name": "MAIL" }],

	// Uncomment to serve at https://telemetry.homespun.photos. The homespun.photos zone must be in
	// the same account; Wrangler creates the DNS record and certificate. See README.md.
	"routes": [{ "pattern": "telemetry.homespun.photos", "custom_domain": true }],

	// Daily retention cleanup, usage reconciliation and budget alerts (UTC).
	"triggers": { "crons": ["17 3 * * *"] }
}
